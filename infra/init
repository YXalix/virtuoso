#!/bin/sh
# Init script for QEMU E2E testing
# Basic skeleton - minimal test environment

#==========================================
# Configuration
#==========================================
TESTS_DIR="/tests"
MODULES_DIR="/lib/modules"

#==========================================
# Module Management
#==========================================

# Load a single module with optional args.
# Usage: mod_load <module> [key=val ...]
mod_load() {
    local mod="$1"
    shift
    local err
    err=$(insmod "$MODULES_DIR/${mod}.ko" "$@" 2>&1) && return 0
    LOG_ERROR "insmod ${mod}.ko $*: $err"
    return 1
}

# Load all modules from modules.conf.
# Each line is "<module> [key=val ...]" — extra tokens are passed to insmod.
load_modules() {
    LOG_INFO "Loading kernel modules..."

    local loaded=0
    local conf="${MODULES_DIR}/modules.conf"

    if [ ! -f "$conf" ]; then
        LOG_WARN "modules.conf not found, skipping"
        return
    fi

    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        [ "${line#\#}" != "$line" ] && continue
        # Split into module name + optional args.
        # shellcheck disable=SC2086
        set -- $line
        if mod_load "$@"; then
            loaded=$((loaded + 1))
        fi
    done < "$conf"

    LOG_INFO "Modules: $loaded loaded"
}

#==========================================
# Helper Functions
#==========================================

LOG_INFO() {
    echo "[INFO] $1"
}

LOG_OK() {
    echo "  [OK] $1"
}

LOG_WARN() {
    echo "  [WARN] $1"
}

LOG_ERROR() {
    echo " [ERROR] $1"
}

# Mount essential filesystems.
# Reached via switch_root: /proc /sys /dev are already mounted by the
# initramfs stage and these remounts no-op (stderr suppressed). Kept so the
# rootfs also boots directly on kernels with root drivers built-in.
mount_filesystems() {
    LOG_INFO "Mounting filesystems..."

    mount -t proc none /proc 2>/dev/null
    mount -t sysfs none /sys 2>/dev/null
    mount -t devtmpfs none /dev 2>/dev/null
    mount -t tmpfs none /tmp 2>/dev/null
    mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
    # The tracefs mount point is created by kernel tracefs init itself
    # (sysfs_create_mount_point); it exists from boot when built in (=y).
    # eBPF tracepoint families (bpftrace tracepoint:, libbpf/aya tp attach)
    # depend on it being visible. kprobe goes through perf PMU, not tracefs;
    # swallow EBUSY when it is already mounted.
    mount -t tracefs none /sys/kernel/tracing 2>/dev/null || true

    mkdir -p /dev/pts /dev/shm 2>/dev/null
    mount -t devpts devpts /dev/pts 2>/dev/null
    mount -t tmpfs tmpfs /dev/shm 2>/dev/null

    LOG_OK "Filesystems mounted"
}

#==========================================
# System Status
#==========================================

# Print system status information
print_status() {
    echo ""
    echo "=========================================="
    echo "QEMU E2E Test Environment"
    echo "=========================================="
    echo "Kernel: $(uname -r)"
    echo "Architecture: $(uname -m)"
    echo ""

    # Block devices
    echo "Block Devices:"
    ls /sys/class/block/ 2>/dev/null | sed 's/^/  /' || echo "  No block devices found"

    echo ""
    echo "Test commands:"
    echo "  Run tests from $TESTS_DIR"
    echo ""
}

# Test selection (from `virtuoso test --only`): the launcher appends
# `virtuoso.only=<entry,...>` to the kernel cmdline; init filters /tests/*.
# Entries: flat test name, "group/case", or "group/" (whole group).
# Absent or empty = run everything. Marker protocol v1 is untouched:
# selected binaries emit the full marker set, unselected ones stay silent.
ONLY=""

parse_only() {
    for tok in $(cat /proc/cmdline 2>/dev/null); do
        case "$tok" in
            virtuoso.only=*) ONLY="${tok#virtuoso.only=}" ;;
        esac
    done
}

# selected <name>: true when the name passes the filter (comma-separated
# list). Exact token = one test; trailing-slash token = whole group
# ("smoke/" selects every "smoke/<case>").
selected() {
    [ -z "$ONLY" ] && return 0
    local tok
    # shellcheck disable=SC2086
    for tok in $(printf '%s' "$ONLY" | tr ',' ' '); do
        case "$tok" in
            */)
                case "$1" in
                    "$tok"*) return 0 ;;
                esac
                ;;
            *)
                [ "$1" = "$tok" ] && return 0
                ;;
        esac
    done
    return 1
}

# run_one <name> <exe>: execute one test binary and emit the marker
# protocol v1 lines for it (name token may contain "/" for grouped tests).
run_one() {
    local name="$1" exe="$2"
    test_count=$((test_count + 1))
    echo ""
    echo "--- Running: $name ---"
    if "$exe"; then
        echo "PASSED: $name"
        pass_count=$((pass_count + 1))
    else
        echo "FAILED: $name"
        test_failed=1
    fi
}

# Run all tests in /tests directory. Flat executables are the default
# group (name = basename); one-level subdirectories are test groups
# (name = "group/case", group dirs are NOT recursed further).
run_auto_tests() {
    parse_only
    echo ""
    echo "=========================================="
    echo "AUTO-TEST MODE: Running test suite..."
    echo "=========================================="
    [ -n "$ONLY" ] && echo "Filter: $ONLY"
    echo ""

    test_failed=0
    test_count=0
    pass_count=0

    for entry in "$TESTS_DIR"/*; do
        if [ -d "$entry" ]; then
            group=$(basename "$entry")
            for exe in "$entry"/*; do
                [ -f "$exe" ] && [ -x "$exe" ] || continue
                test_name="$group/$(basename "$exe")"
                selected "$test_name" || continue
                run_one "$test_name" "$exe"
            done
        elif [ -f "$entry" ] && [ -x "$entry" ]; then
            test_name=$(basename "$entry")
            selected "$test_name" || continue
            run_one "$test_name" "$entry"
        fi
    done

    if [ $test_count -eq 0 ]; then
        if [ -n "$ONLY" ]; then
            # A filter that matches nothing must not read as a green 0/0
            LOG_ERROR "virtuoso.only=$ONLY matched no tests in $TESTS_DIR (typo?)"
            test_failed=1
        else
            LOG_WARN "No tests found in $TESTS_DIR"
        fi
    fi

    echo ""
    echo "=========================================="
    echo "Test Results: $pass_count/$test_count passed"
    if [ $test_failed -eq 0 ]; then
        echo "TEST_COMPLETE: ALL TESTS PASSED"
    else
        echo "TEST_COMPLETE: SOME TESTS FAILED"
    fi
    echo "=========================================="

    return $test_failed
}

# Power off the VM
power_off() {
    echo ""
    LOG_INFO "Powering off..."
    poweroff -f || LOG_ERROR "poweroff returned nonzero (continuing)"
}

#==========================================
# Main Execution
#==========================================

main() {
    # Mount filesystems
    mount_filesystems

    # Phase 2 InitHook injection point: declarative customization generated
    # by overture (no such file by default)
    [ -f /init-hooks.sh ] && . /init-hooks.sh

    # Load test modules (boot-critical ones were loaded by the initramfs)
    load_modules

    # Virtuoso tools (resident tools, not test cases): mounted at /tools from
    # the attached tools.img data disk (see /init-hooks.sh, PATH already
    # injected), started in guarded mode. They only actually stay resident
    # when the tools disk mounts and the virtio-serial port driver is loaded;
    # missing either, the agent exits on its own — zero impact on interactive
    # and auto_test behavior.
    if command -v virtuoso-agent >/dev/null 2>&1; then
        virtuoso-agent >/dev/null 2>&1 &
    fi

    # Show status
    print_status

    # Check for auto-test mode
    if grep -q "auto_test" /proc/cmdline 2>/dev/null || [ "$AUTO_TEST" = "1" ]; then
        run_auto_tests
        local exit_code=$?
        power_off
        exit $exit_code
    fi

    # Interactive mode: start shell
    setsid cttyhack /bin/sh || exec /bin/sh -l
}

# Run main
main
