// VS Code Dev Container — static template (default volume form: workspaceMount
// pinned to virtuoso-kernel). Multi-volume `--as` names do not come through
// here: `virtuoso kernel use/clone` automatically renders the git-ignored
// `.devcontainer/devcontainer.json` (repo root, auto-discovered by VS Code —
// just "Reopen in Container" on the opened repo; the image is the published
// ghcr image directly, no local build on first entry). customizations stay in
// sync with the rendered template; editor config changes must touch both.
//
// Usage (same on macOS / Linux):
//   1. virtuoso kernel clone <kernel-git-url>   (source into a named volume)
//   2a. Multi-volume / `--as`-named volumes: open the repo root → "Reopen in Container" (consumes the rendered artifact)
//   2b. Default volume: Open Folder in Container → pick this devkit/docker/ directory
//   3. The workspace is /ksrc: clangd indexes in-container; builds go through the integrated terminal:
//      virtuoso kernel build (or plain make)
//
// CDB: `virtuoso kernel build` automatically produces the raw /ksrc-form
// compile_commands.json at the end; in-container clangd consumes it directly,
// with no rewriting step.
//
// Source lives in the volume, not in a mac directory: ext4 is case-sensitive
// (a hard requirement for kernel builds), and it avoids the performance cost
// of APFS bind-mounts. The editing experience is equivalent (the VS Code
// server reads and writes the volume in-container).
{
  "name": "virtuoso-kernel",
  "build": { "dockerfile": "Dockerfile.kernel" },
  "workspaceMount": "src=virtuoso-kernel,dst=/ksrc,type=volume",
  "workspaceFolder": "/ksrc",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "rust-lang.rust-analyzer",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        // clangd runs in-container: consumes /ksrc/.clangd + compile_commands.json
        "clangd.arguments": [
          "--background-index",
          "--clang-tidy=false",
          "--header-insertion=never",
          "--query-driver=/usr/bin/*"
        ],
        // Rust-side indexing: make rust-analyzer in the container produces rust-project.json, picked up automatically by the extension
        // Kernel C style: 8-space indent; the Rust side uses standard rustfmt 4-space
        "editor.tabSize": 8,
        "[c]": { "editor.insertSpaces": false },
        "[rust]": { "editor.tabSize": 4 },
        "files.exclude": {
          "**/*.o": true,
          "**/*.cmd": true,
          "**/*.ko": true,
          "**/.*.cmd": true
        }
      }
    }
  }
}
