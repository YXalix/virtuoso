// VS Code Dev Container —— 静态模板（缺省卷形态：workspaceMount 钉死
// virtuoso-kernel）。`--as` 命名的多卷不进这里：`virtuoso kernel
// use/clone` 会按 current 活动卷 + 钉死工具链镜像自动渲染 git 忽略的
// `.devcontainer/devcontainer.json`（repo 根，VS Code 自动发现——打开
// 仓库「Reopen in Container」即可；image 直用 ghcr 发布镜像、首进免本地
// build）。customizations 与渲染模板保持同源，改编辑器配置两处都要动。
//
// 用法（macOS / Linux 通用）：
//   1. virtuoso kernel clone <kernel-git-url>   （源码进 named volume）
//   2a. 多卷/`--as` 命名卷：打开 repo 根 →「Reopen in Container」（吃渲染产物）
//   2b. 缺省卷：Open Folder in Container → 选本 devkit/docker/ 目录
//   3. workspace 即 /ksrc：clangd 在容器内索引，构建走集成终端
//      virtuoso kernel build（或直接 make）
//
// CDB：`virtuoso kernel build` 末尾自动产出 /ksrc 原始形态的
// compile_commands.json，容器内 clangd 直接消费，无需任何改写步骤。
//
// 源码在 volume 里而不在 mac 目录：ext4 大小写敏感（内核构建的硬要求），
// 且避免 APFS bind-mount 的性能损耗。编辑器体验等价（VS Code server 在
// 容器内读写 volume）。
{
  "name": "virtuoso-kernel",
  "build": { "dockerfile": "Dockerfile.kernel" },
  "workspaceMount": "src=virtuoso-kernel,dst=/ksrc,type=volume",
  "workspaceFolder": "/ksrc",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "rust-lang.rust-analyzer",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        // clangd 在容器内跑：吃 /ksrc/.clangd + compile_commands.json
        "clangd.arguments": [
          "--background-index",
          "--clang-tidy=false",
          "--header-insertion=never",
          "--query-driver=/usr/bin/*"
        ],
        // Rust 侧索引：容器里 make rust-analyzer 产出 rust-project.json，扩展自动拾取
        // 内核 C 风格：8 空格缩进；Rust 侧走标准 rustfmt 四空格
        "editor.tabSize": 8,
        "[c]": { "editor.insertSpaces": false },
        "[rust]": { "editor.tabSize": 4 },
        "files.exclude": {
          "**/*.o": true,
          "**/*.cmd": true,
          "**/*.ko": true,
          "**/.*.cmd": true
        }
      }
    }
  }
}
