# clangd 配置 —— 本文件是唯一模板：`virtuoso kernel clone` 时按目标架构
# 渲染（--target 行替换）拷入内核源码根。
#
# 数据链：内核构建后 `virtuoso kernel build` 末尾跑内核自带的
# gen_compile_commands.py（从 .cmd 文件聚合，无需 bear）在源码根产出
# compile_commands.json；容器内 clangd（VS Code devcontainer）读它拿到每个
# 翻译单元的真实编译命令。本文件做两件事：
# 1. Remove：剥掉 GCC 专有 / clangd 不认识的 flag（否则每个 TU 都是一排
#    unknown warning，索引仍然工作，但太吵）；
# 2. Add：交叉目标（compile_commands 里已是交叉 gcc，--target 双保险）。
#
# 换目标架构：`virtuoso kernel clone --arch <a>` 按架构渲染（arm64 为缺省）。

CompileFlags:
  Add:
    - --target=aarch64-linux-gnu
    - -fno-spell-checking
  Remove:
    # GCC-only 优化/诊断 flag（clang 接受前缀形式但会告警）
    - -W*
    - -Wa,*
    - -fconserve-stack
    - -fno-ipa-sra
    - -fno-var-tracking*
    - -fno-delete-null-pointer-checks
    - -fno-allow-store-data-races
    - -fno-reorder-blocks-and-partition
    - -fno-stack-protector*
    - -mrecord-mcount
    - -mno-red-zone
    - -mpreferred-stack-boundary*
    - -mabi*
    - -mfpu*
    - -mfloat-abi*
    # GCC-only 调试 flag：主线 defconfig 开 CONFIG_DEBUG_INFO_REDUCED=y 时
    # Kbuild 注入（oe66 未开，故 oe66 时代模板未覆盖——clangd 对未知 -f
    # 直接 fatal，后续 incomplete type / too many errors 全是级联噪声）
    - -femit-struct-debug-baseonly
    - -femit-struct-debug-detailed=*
    # 交叉链接期 flag，索引不消费
    - --param*
    - -falign-*

Diagnostics:
  ClangTidy:
    Remove: "*"
  UnusedIncludes: None
  MissingIncludes: None
