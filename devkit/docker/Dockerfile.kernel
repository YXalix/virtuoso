# virtuoso kernel builder — a pinned toolchain in the style of Firecracker's build-docker.
#
# Design constraints (full usage in devkit/docker/README.md):
# - Only does what macOS cannot: building the Linux kernel and the clangd indexing environment;
#   test asset builds and QEMU runs stay native on the host (macOS uses HVF, unavailable in the container).
# - The container runs natively as linux/arm64 on Apple Silicon (Docker Desktop /
#   OrbStack / colima all work, no nested virtualization needed); an arm64 kernel is a native frontend in-container;
#   x86_64 / riscv64 are cross-built in-container (CROSS_COMPILE, see forge::toolchain::make_env).
# - Kernel source lives in a named volume (ext4 is case-sensitive, sidestepping the APFS case-insensitivity pitfall).
# - CI (kernel-builder.yml) publishes to ghcr.io/yxalix/virtuoso-kernel;
#   when `virtuoso kernel` (forge) cannot pull the image, it falls back to a local build from this file.

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        build-essential bc bison flex libelf-dev libssl-dev dwarves \
        # Static bpftool (provisioned alongside the kernel build): libelf.a pulls in zstd; static linking must list it explicitly
        zlib1g-dev libzstd-dev \
        # Rust for Linux: bindgen-cli dynamically links libclang via llvm-sys (needed at both build and run time)
        libclang-dev \
        curl \
        python3 cpio xz-utils file patch rsync \
        # All three architectures covered: native (build-essential) + two cross-compilers
        gcc-aarch64-linux-gnu gcc-x86-64-linux-gnu gcc-riscv64-linux-gnu \
        # Code browsing: clangd (compile_commands.json is generated by the kernel's own script)
        clangd \
        git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Rust for Linux toolchain — rustc pinned to current stable (the kernel tree's min-tool-version is
# the floor; the real hard constraint is the rust-analyzer extension's proc-macro ABI window: a
# proc-macro compiled by an older rustc and expanded by a newer RA panics deserializing span maps
# — both ends must be the same generation).
# After a mainline tree upgrade, check both in sync: the scripts/min-tool-version.sh floor and
# the RA extension generation.
# rustup installs system-wide into /usr/local; bindgen is built from source with cargo --locked,
# compiled natively on both arm64/amd64 bases. After bumping the rustc version you must rebuild
# the kernel and regenerate rust-project.json
# (its sysroot path embeds the toolchain version number).
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --profile minimal --default-toolchain 1.98.0 \
        --component rust-src --component clippy --component rustfmt && \
    cargo install --locked --version 0.71.1 bindgen-cli && \
    rm -rf "${CARGO_HOME}/registry"

WORKDIR /ksrc

# Allow clangd to query the compiler for system includes (extracts the query path from the kernel's cross gcc)
ENV CLANGD_FLAGS="--query-driver=/usr/bin/*"

CMD ["/bin/bash"]
